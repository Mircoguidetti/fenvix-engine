            lt = threading.Thread(target=lease_rounds, args=(ff, "S1", 2 if throttled else 5, stop))
            lt.start()
            b = 0
            size = 101_000 if throttled else 120_000
            while lt.is_alive() and (not throttled or b < 2):
                if throttled:
