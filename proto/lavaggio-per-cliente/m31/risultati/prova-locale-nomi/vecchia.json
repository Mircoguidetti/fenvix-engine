{"Version": "2012-10-17", "Statement": [{"Sid": "Letture", "Effect": "Allow", "Action": ["ec2:DescribeVpcs", "ec2:DescribeSubnets", "ec2:DescribeInstances", "s3:ListAllMyBuckets"], "Resource": "*"}, {"Sid": "ImmagineUbuntuPubblica", "Effect": "Allow", "Action": "ssm:GetParameter", "Resource": "arn:aws:ssm:eu-west-1::parameter/aws/service/canonical/*"}, {"Sid": "MacchinaSoloC7iXlargeConIlTag", "Effect": "Allow", "Action": "ec2:RunInstances", "Resource": ["arn:aws:ec2:eu-west-1:123456789012:instance/*", "arn:aws:ec2:eu-west-1:123456789012:volume/*"], "Condition": {"StringEquals": {"aws:RequestTag/progetto": "fenvix-m31"}, "StringEqualsIfExists": {"ec2:InstanceType": "c7i.xlarge"}}}, {"Sid": "MacchinaRisorseDiServizio", "Effect": "Allow", "Action": "ec2:RunInstances", "Resource": ["arn:aws:ec2:eu-west-1::image/*", "arn:aws:ec2:eu-west-1:123456789012:subnet/*", "arn:aws:ec2:eu-west-1:123456789012:network-interface/*", "arn:aws:ec2:eu-west-1:123456789012:security-group/*"]}, {"Sid": "TagSoloAlLancio", "Effect": "Allow", "Action": "ec2:CreateTags", "Resource": ["arn:aws:ec2:eu-west-1:123456789012:instance/*", "arn:aws:ec2:eu-west-1:123456789012:volume/*"], "Condition": {"StringEquals": {"ec2:CreateAction": "RunInstances"}}}, {"Sid": "CancellareSoloLeMacchineM31", "Effect": "Allow", "Action": "ec2:TerminateInstances", "Resource": "arn:aws:ec2:eu-west-1:123456789012:instance/*", "Condition": {"StringEquals": {"ec2:ResourceTag/progetto": "fenvix-m31"}}}, {"Sid": "PassareSoloIlRuoloDellaMacchina", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::123456789012:role/fenvix-m31-macchina", "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}}, {"Sid": "LeggereIlProfiloDellaMacchina", "Effect": "Allow", "Action": "iam:GetInstanceProfile", "Resource": "arn:aws:iam::123456789012:instance-profile/fenvix-m31-macchina"}, {"Sid": "BucketDellaProva", "Effect": "Allow", "Action": ["s3:CreateBucket", "s3:DeleteBucket", "s3:PutBucketTagging", "s3:PutLifecycleConfiguration", "s3:PutBucketPublicAccessBlock", "s3:ListBucket", "s3:ListBucketMultipartUploads", "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"], "Resource": ["arn:aws:s3:::fenvix-m31-*", "arn:aws:s3:::fenvix-m31-*/*"]}]}