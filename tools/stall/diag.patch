+// DIAG (diagnosis build only)
+pub static DIAG_QUEUE: std::sync::OnceLock<Arc<CompactionQueue>> = std::sync::OnceLock::new();
+pub async fn diag_state(store: &Arc<dyn ObjectStore>, locks: &MaintLocks) -> String {
+    let mut out = String::new();
+    let dbs: Vec<(String, Db)> = WRITER_DBS.lock().unwrap().iter().map(|(k, v)| (k.clone(), v.clone())).collect();
+    let pending: Vec<(String, usize)> = DIAG_QUEUE.get().map(|q| q.pending.lock().unwrap().iter().map(|(k, v)| (k.clone(), v.len())).collect()).unwrap_or_default();
+    out += &format!("DIAG state unix_ms={} open_writers={} queue_pending={:?} lock_entries={}\n", unix_ms(), dbs.len(), pending, locks.lock().unwrap().len());
+    for (id, db) in dbs {
+        let m = db.manifest();
+        let st = db.status();
+        let lock_free = maint_lock(locks, &id).try_lock().is_ok();
+        let store_l0 = l0_count(store, &id).await.map_err(|e| e.to_string());
+        let hot = GC_HOT.lock().unwrap().get(&id).map(|h| (h.last_write.elapsed().as_secs(), h.last_sst_gc.elapsed().as_secs(), h.sst_manifest));
+        out += &format!(
+            "DIAG writer tenant={id} writer_manifest_id={} writer_l0={} writer_sorted_runs={} last_l0_seq={} durable_seq={} store_l0={:?} maint_lock_free={lock_free} hot(last_write_s,last_sstgc_s,sst_manifest)={:?} closed={:?}\n",
+            m.id(), m.l0().len(), m.compacted().len(), m.last_l0_seq(), st.durable_seq, store_l0, hot, st.close_reason
+        );
+    }
+    out
+}
