#!/bin/bash
# Prova locale cucina minima (K2; copia di P1 Irlanda) · finto `shutdown` della macchina: scrive cosa gli chiedono; "now" = la macchina si spegne, cioè
# (spegnimento = cancellazione) terminate-instances su moto e fine dei suoi processi. "+N" si registra soltanto
# (240 minuti veri non si aspettano in una prova).
echo "$(date +%T) shutdown $*" >> "$(dirname "$IRL_DIR")/shutdown.log"
for a in "$@"; do
  if [ "$a" = now ]; then
    aws ec2 terminate-instances --instance-ids "$IRL_ID" > /dev/null 2>&1
    exit 0
  fi
done
exit 0
